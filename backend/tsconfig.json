{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler", // Идеально для ESNext и современных сборщиков/раннеров
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "**/*",            // Все файлы внутри backend
    "../shared/**/*"   // Явно включаем типы из общей папки shared
  ]
}
